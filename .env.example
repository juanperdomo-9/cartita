# Copiá este archivo a backend/.env (backend) y frontend/.env.local (solo VITE_*).
# Nunca subas los archivos .env reales al repo.

# ===== Backend =====
# "produccion" en Render: exige TOKEN_PEPPER y SUPABASE_URL
ENTORNO=desarrollo
# Local: el Postgres de docker-compose.yml. En producción: el pooler de Supabase.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/cartita
# Pooler de Supabase en modo transacción (puerto 6543). Sirve "postgresql://..." tal cual.
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Si SUPABASE_URL queda vacía, las fotos y audios se guardan en backend/.almacen (solo desarrollo)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
# Clave de servicio: SOLO en el backend, nunca en el frontend
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=cartas
# Secreto largo y aleatorio (por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(32))")
TOKEN_PEPPER=
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
PAGOS_ACTIVOS=false
# Solo etapa 2
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ===== Frontend (solo desarrollo: en Render la web y la API son un solo servicio) =====
# URL pública del backend (Vite solo expone las variables que empiezan con VITE_)
VITE_API_URL=http://localhost:8000
# URL pública del frontend (para la imagen de la vista previa de WhatsApp)
VITE_SITIO_URL=http://localhost:5173
