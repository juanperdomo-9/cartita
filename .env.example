# Copiá este archivo a backend/.env (backend) y frontend/.env.local (solo VITE_*).
# Nunca subas los archivos .env reales al repo.

# ===== Backend =====
# Pooler de Supabase en modo transacción (puerto 6543). Sirve "postgresql://..." tal cual.
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://TU_PROYECTO.supabase.co
# Clave de servicio: SOLO en el backend, nunca en el frontend
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=cartas
# Secreto largo y aleatorio (por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(32))")
TOKEN_PEPPER=
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
PAGOS_ACTIVOS=false
# Solo etapa 2
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ===== Frontend =====
# URL pública del backend (Vite solo expone las variables que empiezan con VITE_)
VITE_API_URL=http://localhost:8000
